module biu32_axi(
rstn,clk, 
write_req, write_ack, write_data, write_msk,
read_req , read_ack , read_data,
Daddr,
code_req , code_ack , code_data , code_addr,
code_wreq, code_wack, code_wdata,
readio_req, writeio_req, readio_ack, writeio_ack,
writeio_data, readio_data, io_add, 
 
// AXI4 32 BIT BUS
axi_AW, axi_AWVALID, axi_AWREADY,  axi_AWBURST, axi_AWLEN , axi_AWSIZE,
axi_W, axi_WVALID, axi_WREADY, axi_WSTRB, axi_WLAST,
axi_AR, axi_ARVALID, axi_ARREADY, axi_ARBURST, axi_ARLEN, axi_ARSIZE,
axi_R, axi_RVALID, axi_RREADY, axi_RLAST,
// AXI4 PERIPH IOBUS 32 BIT BUS ( IN FACT ONLY 8 LSB USED)
axi_io_AW, axi_io_AWVALID, axi_io_AWREADY,  axi_io_AWBURST, axi_io_AWLEN , axi_io_AWSIZE,
axi_io_W, axi_io_WVALID, axi_io_WREADY, axi_io_WSTRB, axi_io_WLAST,
axi_io_AR, axi_io_ARVALID, axi_io_ARREADY, axi_io_ARBURST, axi_io_ARLEN, axi_io_ARSIZE,
axi_io_R, axi_io_RVALID, axi_io_RREADY, axi_io_RLAST,

busy, debug
);

//ports
input       clk,rstn,write_req,read_req,code_req,code_wreq;
input [3:0] write_msk;
output reg  code_wack;
output      write_ack;
output      read_ack,code_ack;
input       [31:0] code_wdata,write_data,Daddr,code_addr;
output      [31:0] read_data;
output reg [127:0] code_data;
output reg  [31:0] readio_data;
input       [31:0] writeio_data;
output reg  readio_ack,writeio_ack;
input       readio_req,writeio_req;
input       [31:0] io_add;

// axi bus
output reg [31:0] axi_AW, axi_AR;
output reg 	  axi_AWVALID,axi_ARVALID,axi_WVALID,axi_RREADY,axi_WLAST;
input      	  axi_AWREADY,axi_ARREADY,axi_WREADY,axi_RVALID,axi_RLAST;
input      [31:0] axi_R;
output reg [31:0] axi_W;
output reg  [3:0] axi_WSTRB;
output reg  [1:0] axi_ARBURST,axi_AWBURST;
output reg  [7:0] axi_ARLEN, axi_AWLEN;
output reg  [2:0] axi_ARSIZE, axi_AWSIZE;

// axi_io bus
output reg [31:0] axi_io_AW, axi_io_AR;
output reg 	  axi_io_AWVALID,axi_io_ARVALID,axi_io_WVALID,axi_io_RREADY,axi_io_WLAST;
input      	  axi_io_AWREADY,axi_io_ARREADY,axi_io_WREADY,axi_io_RVALID,axi_io_RLAST;
input      [31:0] axi_io_R;
output reg [31:0] axi_io_W;
output      [3:0] axi_io_WSTRB;
output      [1:0] axi_io_ARBURST,axi_io_AWBURST;
output      [7:0] axi_io_ARLEN, axi_io_AWLEN;
output      [2:0] axi_io_ARSIZE, axi_io_AWSIZE;

output            busy;
output      [4:0] debug;

// internal wires
reg [1:0] code2;
wire [31:0] A32 = {Daddr[31:2],2'b0};
wire [31:0] A = Daddr;
reg          read_ack_slow,code_ack_slow;
reg    [4:0] fsm;
reg          wrint_ack,fsmz;
reg    [4:0] burst_idx;
reg    [1:0] read_szf,write_szf;
reg          abort;
reg          wf,rf;

// cache wires
wire  [31:0] cacheD;
wire  [6:0] cacheA;
reg         cacheWEN; 
reg  [31:0] tag1,tag2,tag3,tag4,tag5,tag6,tag7,tag8;
wire  [7:0] cacheTAGhit;
reg  [31:0] Ac;
wire [31:0] cacheQ;
wire  [2:0] cacheOFS;
reg  [31:0] cacheW;
reg   [3:0] cacheM;
reg   [2:0] lastnx;

assign debug = fsm;
assign read_data = cacheQ;
assign code_ack = code_ack_slow;
assign read_ack = read_ack_slow;
assign write_ack = wrint_ack ;
assign busy = (fsm !=0 ) ? (code_req|read_req|write_req|code_wreq) : 1'b0;

always @(posedge clk or negedge rstn) 
if (~rstn) fsmz        <= 0; else if (fsm == 0) fsmz <= 1; else fsmz <= 0;


assign cacheD = (axi_RVALID) ? axi_R : cacheW;

datacache datacache1 (
.clk(clk),
.WEN(cacheWEN),
.RA({cacheOFS,burst_idx[3:0]}),
.WA({cacheOFS,burst_idx[3:0]}),
.D(cacheD),
.Q(cacheQ),
.M(cacheM)
);

assign cacheOFS = (tag1[31:6] == Ac[31:6]) ? 3'b000 :
                  (tag2[31:6] == Ac[31:6]) ? 3'b001 :
                  (tag3[31:6] == Ac[31:6]) ? 3'b010 :
                  (tag4[31:6] == Ac[31:6]) ? 3'b011 :
                  (tag5[31:6] == Ac[31:6]) ? 3'b100 :
                  (tag6[31:6] == Ac[31:6]) ? 3'b101 :
                  (tag7[31:6] == Ac[31:6]) ? 3'b110 :
                  (tag8[31:6] == Ac[31:6]) ? 3'b111 : 0;

assign cacheA = {cacheOFS,burst_idx[3:0]};

assign cacheTAGhit[0] = (tag1[31:6] == Ac[31:6]) ? 1:0;
assign cacheTAGhit[1] = (tag2[31:6] == Ac[31:6]) ? 1:0;
assign cacheTAGhit[2] = (tag3[31:6] == Ac[31:6]) ? 1:0;
assign cacheTAGhit[3] = (tag4[31:6] == Ac[31:6]) ? 1:0;
assign cacheTAGhit[4] = (tag5[31:6] == Ac[31:6]) ? 1:0;
assign cacheTAGhit[5] = (tag6[31:6] == Ac[31:6]) ? 1:0;
assign cacheTAGhit[6] = (tag7[31:6] == Ac[31:6]) ? 1:0;
assign cacheTAGhit[7] = (tag8[31:6] == Ac[31:6]) ? 1:0;

always @(posedge clk or negedge rstn) 
if (~rstn)
 begin 
   abort         <= 0;                  // if code_req is =0 during prefetch transaction then it is an abort , most likely issued from a jump or decode pipe interruption. 
   axi_AW        <= 0; axi_AR      <=0; // AXI ADDRESS OUTPUTS
   axi_AWVALID   <= 0; axi_ARVALID <=0; // AXI ADRESS VALID OUTPUTS
   axi_WVALID    <= 0; axi_RREADY  <=0; // AXI R/W CHANNEL REQUESTS
   axi_W         <= 0;                  // AXI DATA TO WRITE 
   axi_WSTRB     <= 0;                  // AXI DATA TO WRITE STROBE
   axi_ARSIZE    <= 3'h2;               // DEFAULT SIZE is 2^2 = 4 bytes , SO 32 bits
   axi_ARLEN     <= 8'h0;               // DEFAULT BURST LENGTH is 1 , SO NO BURST
   axi_ARBURST   <= 2'h1;               // DEFAULT BURST TYPE   is INCREMENT NO WRAP   
   axi_AWSIZE    <= 3'h2;               // DEFAULT SIZE is 2^2 = 4 bytes , SO 32 bits
   axi_AWLEN     <= 8'h0;               // DEFAULT BURST LENGTH is 1 , SO NO BURST
   axi_AWBURST   <= 2'h1;               // DEFAULT BURST TYPE   is INCREMENT NO WRAP  
   axi_WLAST     <= 0;                  // ANYWAY WE DONT BURST IN WRITE MODE 
   fsm           <= 0; 
   read_ack_slow <= 0; wrint_ack <= 0; // RETURN TO CORE HANDSHAKE
   code_ack_slow <= 0; code_wack <= 0; // RETURN TO CORE HANDSHAKE
   read_szf      <= 0;
   write_szf     <= 0;
   cacheWEN      <= 1;
   tag1          <= 32'hffff_0000;
   tag2          <= 32'hffff_0000;
   tag3          <= 32'hffff_0000;
   tag4          <= 32'hffff_0000;
   tag5          <= 32'hffff_0000;
   tag6          <= 32'hffff_0000;
   tag7          <= 32'hffff_0000;
   tag8          <= 32'hffff_0000;
   lastnx        <= 0;
   cacheW        <= 32'h0;
   cacheM        <= 4'b1111;
 end
else
casex ({fsm,(write_req&~wrint_ack),(read_req&~read_ack_slow),(code_req&~code_ack_slow),(code_wreq&~code_wack)})
9'b11111_xxxx: // END CODE READ/WRITE
        begin 
         abort         <= 0;
         fsm           <= 0; 
	 wrint_ack     <= 0; 
         read_ack_slow <= 0; 
         code_ack_slow <= 0; 
         code_wack     <= 0;
         axi_ARVALID   <= 0; 
	 axi_AWVALID   <= 0; 
	 axi_RREADY    <= 0; 
	 axi_WVALID    <= 0; 
	 axi_WSTRB     <= 0; 
	 axi_WLAST     <= 0; 
	 axi_AWLEN     <= 0;
	 axi_ARLEN     <= 0;
	 axi_AW        <= A32; 
	 axi_AR        <= A32; 
	 axi_W         <= write_data; 
	 axi_AWBURST   <= 2'h1;
         axi_ARBURST   <= 2'h1;         
	 axi_AWSIZE    <= 2'h2;
         axi_ARSIZE    <= 2'h2;         
	 Ac            <= Daddr;
         cacheWEN      <= 1;
	end
	
/////////////////////////////////
// Writes
/////////////////////////////////

9'b00000_10xx :  begin 
		  Ac            <= Daddr; 
		  fsm           <= 5'b00001;
		  cacheM        <= write_msk;
		  cacheW        <= write_data;
		  axi_W         <= write_data;
          axi_WSTRB     <= write_msk; 
		  axi_AWLEN     <= 8'd0;	 
		  code_ack_slow <= 0;   
		  wrint_ack     <= 0; 
		  read_ack_slow <= 0;  
		  code_wack     <= 0;
		 end

9'b00001_xxxx : if (cacheTAGhit == 8'b0)
                 begin 
                  axi_AW        <= {Ac[31:2],2'b0}; 
		  fsm           <= 5'b00011;
		 end
		else
		 begin
		  burst_idx     <= {1'b0,Ac[5:2]};
		  cacheWEN      <= 0;
		  wrint_ack     <= 1;
		  // Mark TAG region to be written back once trashed.
		  if (cacheTAGhit[0] == 1'b1) tag1[1]<=1; else
		  if (cacheTAGhit[1] == 1'b1) tag2[1]<=1; else
		  if (cacheTAGhit[2] == 1'b1) tag3[1]<=1; else
		  if (cacheTAGhit[3] == 1'b1) tag4[1]<=1; else
		  if (cacheTAGhit[4] == 1'b1) tag5[1]<=1; else
		  if (cacheTAGhit[5] == 1'b1) tag6[1]<=1; else
		  if (cacheTAGhit[6] == 1'b1) tag7[1]<=1; else
		  if (cacheTAGhit[7] == 1'b1) tag8[1]<=1;
		  fsm<=5'b11111; 
		 end

9'b00011_xxxx : begin
		  axi_AWVALID   <= 1; 
		  axi_WVALID    <= 1; 
		  axi_WLAST     <= 1; 
		  fsm           <= 5'b00101;
		end

9'b00101_xxxx : begin
                if (axi_AWREADY == 1) axi_AWVALID <= 0; 
                if((axi_WREADY  == 1) && (axi_WVALID == 1))
                   begin 
		     wrint_ack   <= 1;
		     fsm         <= 5'b11111; 
		     axi_AWLEN   <= 0; 
		     axi_AWVALID <= 0; 
		     axi_WVALID  <= 0; 
		     axi_WSTRB   <= 0; 
		     axi_AW      <= A32; 
		     axi_WLAST   <= 0; 
		   end // Half : 32bits overlap  	      
                end

/////////////////////////////////////		
// Reads
/////////////////////////////////////

9'b00000_01xx : begin
		  code_ack_slow <= 0;   
          wrint_ack     <= 0; 
          read_ack_slow <= 0;  
          code_wack     <= 0;

		 fsm	       <= 5'b01001; 
	         Ac            <= Daddr;
		 burst_idx     <= {1'b0,Daddr[5:2]};
                 axi_AR	       <= {Daddr[31:6],6'b0};
		 axi_ARLEN     <= 8'd15;
		 axi_AWLEN     <= 8'd15;	      
                end

9'b01001_xxxx : begin
                 if (cacheTAGhit == 8'b0)
                  begin
                   burst_idx     <= 0;		    
		   case(lastnx)   
           3'b000: begin 
                    tag1 <= {Daddr[31:6],6'b000001}; 
                    if (tag1[1]) begin axi_AWVALID <= 1; axi_AW <= {tag1[31:6],6'b0}; fsm <= 5'b01101; burst_idx <=0; end else 
                                 begin axi_ARVALID <= 1; axi_RREADY <= 1; cacheWEN <=0; cacheM <= 4'hf; fsm <= 5'b01011; end 
                   end
           3'b001: begin 
                    tag2 <= {Daddr[31:6],6'b000001}; 
                    if (tag2[1]) begin axi_AWVALID <= 1; axi_AW <= {tag2[31:6],6'b0}; fsm <= 5'b01101; burst_idx <=0; end else 
                                 begin axi_ARVALID <= 1; axi_RREADY <= 1; cacheWEN <=0; cacheM <= 4'hf; fsm <= 5'b01011; end
                   end
           3'b010: begin 
                    tag3 <= {Daddr[31:6],6'b000001}; 
                    if (tag3[1]) begin axi_AWVALID <= 1; axi_AW <= {tag3[31:6],6'b0}; fsm <= 5'b01101; burst_idx <=0; end else 
                                 begin axi_ARVALID <= 1; axi_RREADY <= 1; cacheWEN <=0; cacheM <= 4'hf; fsm <= 5'b01011; end
                   end
           3'b011: begin 
                    tag4 <= {Daddr[31:6],6'b000001}; 
                    if (tag4[1]) begin axi_AWVALID <= 1; axi_AW <= {tag4[31:6],6'b0}; fsm <= 5'b01101; burst_idx <=0; end else 
                                 begin axi_ARVALID <= 1; axi_RREADY <= 1; cacheWEN <=0; cacheM <= 4'hf; fsm <= 5'b01011; end
                   end
           3'b100: begin
                    tag5 <= {Daddr[31:6],6'b000001}; 
                    if (tag5[1]) begin axi_AWVALID <= 1; axi_AW <= {tag5[31:6],6'b0}; fsm <= 5'b01101; burst_idx <=0; end else 
                                 begin axi_ARVALID <= 1; axi_RREADY <= 1; cacheWEN <=0; cacheM <= 4'hf; fsm <= 5'b01011; end
                   end
           3'b101: begin 
                    tag6 <= {Daddr[31:6],6'b000001}; 
                    if (tag6[1]) begin axi_AWVALID <= 1; axi_AW <= {tag6[31:6],6'b0}; fsm <= 5'b01101; burst_idx <=0;  end else 
                                 begin axi_ARVALID <= 1; axi_RREADY <= 1; cacheWEN <=0; cacheM <= 4'hf; fsm <= 5'b01011; end
                   end
           3'b110: begin 
                    tag7 <= {Daddr[31:6],6'b000001}; 
                    if (tag7[1]) begin axi_AWVALID <= 1; axi_AW <= {tag7[31:6],6'b0}; fsm <= 5'b01101;  burst_idx <=0; end else 
                                 begin axi_ARVALID <= 1; axi_RREADY <= 1; cacheWEN <=0; cacheM <= 4'hf; fsm <= 5'b01011; end
                   end
           3'b111: begin 
                    tag8 <= {Daddr[31:6],6'b000001}; 
                    if (tag8[1]) begin axi_AWVALID <= 1; axi_AW <= {tag8[31:6],6'b0}; fsm <= 5'b01101; burst_idx <=0;  end else 
                                 begin axi_ARVALID <= 1; axi_RREADY <= 1; cacheWEN <=0; cacheM <= 4'hf; fsm <= 5'b01011; end
                   end
		   endcase
		   lastnx <= lastnx +1;
           end
		 else
		  begin
		    fsm       <= 5'b11111;
		    read_ack_slow <= 1'b1;
		  end
	        end
		 
9'b01011_xxxx : begin
                 if (read_req    == 0) abort       <= 1;
                 if (axi_ARREADY == 1) axi_ARVALID <= 0;
                 if (axi_RVALID  == 1)
	              begin   
		            if (axi_RLAST) 
		             begin 
		              axi_RREADY    <= 0;
		              cacheWEN      <= 1;
		              burst_idx <= {1'b0,Ac[5:2]};
		              fsm <= 5'b01100;
		             end
		            else burst_idx     <=  burst_idx +1; 
	              end
	            end

9'b01100_xxxx : fsm <= 5'b01111;

9'b01111_xxxx : begin
                 fsm <= 5'b11111;
                 read_ack_slow <= 1'b1;
                end

9'b01101_xxxx : begin // WRITE BACK
                 if((axi_AWVALID == 1    ) && (axi_AWREADY == 0)) begin axi_WVALID <= 0; end else
                 if((axi_AWVALID == 1    ) && (axi_AWREADY == 1)) begin axi_AWVALID <= 0; axi_WVALID <=1; axi_W <= cacheQ; burst_idx<=1; axi_WSTRB <= 4'b1111; end else
                 if((burst_idx   == 8'd16) && (axi_WVALID  == 1)) begin axi_ARVALID <= 1; axi_RREADY <= 1; fsm <= 5'b01011; burst_idx <=0; axi_WLAST <=0; cacheM <= 4'b1111; cacheWEN <= 1'b0; end else               
                 if((axi_WREADY  == 1    ) && (axi_WVALID  == 1)) begin 
                                                             burst_idx <= burst_idx + 1; 
                                                             axi_WVALID <=0; 
                                                             if (burst_idx==8'd15) begin axi_WLAST <= 1; Ac <= Daddr; end;
                                                            end else                 
                 begin 
                  if (axi_AWVALID == 0) axi_WVALID <=1; 
                  axi_W <= cacheQ; 
                 end
	           end

//////////////////////////////////////////////
// Read Code = pre-fetch
//////////////////////////////////////////////

9'b00000_001x : begin
		 wrint_ack     <= 0; 
		 read_ack_slow <= 0; 
		 code_ack_slow <= 0; 
		 code_wack     <= 0;
                 code2         <=  code_addr[ 1:0]; 
                 axi_AR        <= {code_addr[31:2],2'b0}; 
                 axi_ARVALID   <= 1; 
                 axi_RREADY    <= 1; 
                 burst_idx     <= 0;
		 abort         <= 0;
		 if (code_addr[1:0]==2'b00) axi_ARLEN <= 8'h3;     else axi_ARLEN <= 8'h0;
		 if (code_addr[1:0]==2'b00) fsm       <= 5'b10100; else fsm       <= 5'b10000;
		end
		
9'b10000_xxxx : 
        begin
           if (code_req == 0) abort <= 1;
           if (axi_ARREADY == 1) axi_ARVALID <= 0;
           if (axi_RVALID == 1)
		   begin  
		    fsm           <= 5'b11111;
		    if ((abort == 0) && (code_req == 1)) code_ack_slow <= 1; 
		    axi_RREADY    <= 0; 
                    if (code2[1:0]==2'b01) code_data<={120'h0,axi_R[15: 8]}; else
                    if (code2[1:0]==2'b10) code_data<={120'h0,axi_R[23:16]}; else
                    if (code2[1:0]==2'b11) code_data<={120'h0,axi_R[31:24]}; 
                   end
	end

9'b10100_xxxx : begin
                 if (code_req == 0) abort <= 1;
                 if (axi_ARREADY == 1) axi_ARVALID <= 0;
                 if (axi_RVALID == 1)
	          begin 
	           burst_idx <= burst_idx+1;
	           if (burst_idx == 0) code_data[ 31:  0]<=axi_R; else
	           if (burst_idx == 1) code_data[ 63: 32]<=axi_R; else
	           if (burst_idx == 2) code_data[ 95: 64]<=axi_R; else
	           if (burst_idx == 3) code_data[127: 96]<=axi_R; 
		   if (axi_RLAST) 
		      begin 
		       fsm<=5'b11111; 
		       if ((abort == 0) && (code_req == 1)) code_ack_slow <= 1; 
		       axi_RREADY    <= 0;
		      end
	          end
	        end

/////////////////////////////////////////////////////
// Write Code = update page dirty from MMU
/////////////////////////////////////////////////////

9'b00000_0001 : begin 
		 wrint_ack     <= 0; 
		 read_ack_slow <= 0; 
		 code_ack_slow <= 0; 
		 code_wack     <= 0; 
                 fsm           <= 5'b10010; 
		 axi_AW        <= {code_addr[31:2],2'b00}; 
		 axi_AWVALID   <= 1; 
		 axi_W         <= {24'b0,code_wdata[ 7: 0]}; 
		 axi_WVALID    <= 1; 
		 axi_WSTRB     <= 4'b0001;
		 axi_WLAST     <= 1; 
		 axi_AWLEN     <= 0;
		end
		 		
9'b10010_xxxx : begin
                 if (axi_AWREADY == 1) axi_AWVALID <= 0;
                 if (axi_WREADY  == 1) begin code_wack   <= 1; fsm <= 5'b11111; axi_WVALID <=0; end
		end
endcase


always @(posedge clk or negedge rstn) 
if (~rstn)
begin
 writeio_ack <=0;
 readio_ack <=0;
 axi_io_AW <=0; 
 axi_io_AR <=0;
 axi_io_AWVALID <=0;
 axi_io_ARVALID <=0;
 axi_io_WVALID <=0;
 axi_io_RREADY <=0;
 axi_io_WLAST <=0;
 axi_io_W <=0;
 wf <=0; rf <=0;
end
else
begin
 wf <= writeio_req; rf <= readio_req;
 if (readio_ack ==1) readio_ack <= 0; else
 if (writeio_ack ==1) writeio_ack <= 0; else
 if ((axi_io_AWVALID ==1) && (axi_io_AWREADY==1)) begin axi_io_WVALID <=1; axi_io_AWVALID <=0; axi_io_WLAST <=1; end else
 if ((axi_io_WVALID  ==1) && (axi_io_WREADY ==1)) begin axi_io_WVALID <=0; writeio_ack <=1; axi_io_WLAST <=0; end else 
 if ((axi_io_ARVALID ==1) && (axi_io_ARREADY==1)) begin axi_io_RREADY <=1; axi_io_ARVALID <=0; end else
 if ((axi_io_RVALID  ==1) && (axi_io_RREADY ==1)) begin axi_io_RREADY <=0; readio_ack <=1; readio_data<= axi_io_R; end else 
 if ((writeio_req ==1) && (wf == 0))
  begin
   axi_io_AW <= {14'b0,io_add[15:0],2'b0};
   axi_io_AWVALID <=1;
   axi_io_W <= writeio_data;
  end
 else
 if ((readio_req ==1) &&(rf == 0))
  begin
   axi_io_AR <= {14'b0,io_add[15:0],2'b0};
   axi_io_ARVALID <=1;
  end
end

assign axi_io_ARSIZE = 3'h2;
assign axi_io_AWSIZE = 3'h2;
assign axi_io_ARLEN =8'h0;
assign axi_io_AWLEN =8'h0;
assign axi_io_ARBURST =2'h1;
assign axi_io_AWBURST =2'h1;
assign axi_io_WSTRB =4'h1;

endmodule
