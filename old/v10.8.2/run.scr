echo "Generating boot mem file for simulation ..."
\rm test.asm
as ../../boot/test.s -o test.o
objcopy -O ihex test.o test.ihex
objdump -m i386 -d test.o > test.asm
./ihex2mem.tcl -ihex test.ihex -out code.mem -mem_size 1024
\cp code.mem boot.mem

cp ../../bin/vmlinux.raw bin2v.bin
./bin2v4.tcl
cp bin2v-1.mem /home/leo/cpu/mem/vmlinux-1.mem
cp bin2v-2.mem /home/leo/cpu/mem/vmlinux-2.mem
cp bin2v-3.mem /home/leo/cpu/mem/vmlinux-3.mem
cp bin2v-4.mem /home/leo/cpu/mem/vmlinux-4.mem


